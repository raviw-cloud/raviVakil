{
  "name": "contract-clause-analyzer",
  "version": "1.0.0",
  "description": "AI-powered neutral contract review web app",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && copyfiles -u 1 \"src/views/**/*\" dist",
    "start": "node dist/server.js",
    "test": "tsx test/score.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "canvas": "^3.2.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.4.1",
    "handlebars": "^4.7.8",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^3.11.174",
    "pdfkit": "^0.15.0",
    "puppeteer": "^24.43.0",
    "uuid": "^9.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/pdfkit": "^0.13.4",
    "@types/uuid": "^9.0.8",
    "copyfiles": "^2.4.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
